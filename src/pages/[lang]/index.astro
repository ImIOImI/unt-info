---
import Base from '../../layouts/Base.astro';
import Home from '../../components/page/Home.astro';
import { SUPPORTED, useTranslations, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return SUPPORTED.filter((l) => l !== 'en').map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---
<Base lang={lang} path="" title={`${t('site.title')} — ${t('site.tagline')}`}>
  <Home lang={lang} />
</Base>
