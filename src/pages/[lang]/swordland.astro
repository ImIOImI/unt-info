---
import Base from '../../layouts/Base.astro';
import Swordland from '../../components/page/Swordland.astro';
import { SUPPORTED, useTranslations, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return SUPPORTED.filter((l) => l !== 'en').map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---
<Base lang={lang} path="swordland" title={`${t('sl.title')} — ${t('site.title')}`}>
  <Swordland lang={lang} />
</Base>
