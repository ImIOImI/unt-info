---
/**
 * The team sheet: who plays, by legion and squad.
 *
 * Both legions are rendered. The script hides the second and reveals the
 * toggle, so with JavaScript off the page still lists everybody rather than
 * showing two dead buttons — the same bargain the countdown makes.
 *
 * Names appear EXACTLY as the game prints them, special characters and all.
 * Uppercasing or transliterating them would break the one job this section
 * has, which is letting a player match a face to a name in chat.
 */
import { Image } from 'astro:assets';
import { LEGIONS, SQUAD_ORDER } from '../content/legions';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const faces = import.meta.glob<{ default: ImageMetadata }>(
  '/src/avatars/*.{png,jpg,jpeg,webp}',
  { eager: true },
);
const faceFor = (stem: string) =>
  Object.entries(faces).find(([p]) => new RegExp(`/${stem}\\.[a-z]+$`, 'i').test(p))?.[1].default;
---
<div class="legions" data-legions>
  <div class="legions__pick" role="group" aria-label={t('squads.pick')}>
    {LEGIONS.map((legion, i) => (
      <button type="button" data-pick={legion.n} aria-pressed={i === 0 ? 'true' : 'false'}>
        {t('squads.legion', { n: legion.n })}
      </button>
    ))}
  </div>

  {LEGIONS.map((legion) => (
    <section class="legion" data-legion={legion.n} aria-label={t('squads.legion', { n: legion.n })}>
      <h3 class="legion__name">{t('squads.legion', { n: legion.n })}</h3>
      <div class="legion__squads">
        {SQUAD_ORDER.map((squad) => (
          <div class="squad" data-squad={squad}>
            <header class="squad__hd">
              <p class="squad__n">{legion.squads[squad].length}</p>
              <h4 class="squad__name">{t(`team.${squad}.name`)}</h4>
            </header>
            <ul class="faces">
              {legion.squads[squad].map((p) => {
                const face = faceFor(p.avatar);
                const lead = p.rank === 'R4' || p.rank === 'Leader';
                return (
                  <li class="face" data-lead={lead ? '1' : undefined}>
                    {face
                      ? <Image class="face__img" src={face} alt="" widths={[80, 160]} sizes="80px" loading="lazy" />
                      : <span class="face__img face__img--blank" aria-hidden="true">{p.name.slice(0, 1)}</span>}
                    <span class="face__name">{p.name}</span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </section>
  ))}
</div>

<style>
  /* Hidden until the script proves it works; otherwise both legions just
     stack and the buttons never appear. */
  .legions__pick { display: none; }
  .legions.is-live .legions__pick { display: flex; margin: 0 0 2rem; }
  .legions.is-live .legion__name { position: absolute; width: 1px; height: 1px;
    overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .legions__pick button {
    font-family: var(--display);
    font-weight: 700;
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.6rem 1.2rem;
    color: rgb(237 241 245 / 0.72);
    background: transparent;
    border: 1px solid rgb(237 241 245 / 0.28);
    margin-inline-end: -1px;
    cursor: pointer;
  }
  .legions__pick button[aria-pressed='true'] {
    background: var(--ember-lift);
    border-color: var(--ember-lift);
    color: var(--iron);
    position: relative;
    z-index: 1;
  }
  .legions__pick button:focus-visible { outline: 2px solid var(--ember-lift); outline-offset: 2px; }

  .legion + .legion { margin-top: 3rem; }
  .legion__name { font-size: 1.25rem; margin: 0 0 1.5rem;
    padding-bottom: 0.6rem; border-bottom: 2px solid var(--ember-lift); }

  .legion__squads { display: grid; gap: 2.25rem; }
  @media (min-width: 52rem) {
    .legion__squads { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.75rem; }
  }

  .squad { --sq: var(--ember-lift); }
  .squad[data-squad='jump']    { --sq: var(--brass-lift); }
  .squad[data-squad='support'] { --sq: var(--steel-lift); }

  .squad__hd {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    column-gap: 0.6rem;
    border-bottom: 2px solid var(--sq);
    padding-bottom: 0.55rem;
    margin-bottom: 1.1rem;
  }
  .squad__n {
    margin: 0;
    font-family: var(--display);
    font-weight: 900;
    font-size: 1.4rem;
    color: rgb(237 241 245 / 0.35);
    font-variant-numeric: tabular-nums;
  }
  .squad__name {
    margin: 0;
    font-size: 1.4rem;
    font-variation-settings: 'wdth' 84;
    color: var(--sq);
  }

  .faces {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 1rem 0.7rem;
    grid-template-columns: repeat(auto-fill, minmax(4.4rem, 1fr));
  }
  .face { display: flex; flex-direction: column; align-items: center;
    text-align: center; gap: 0.45rem; }
  .face__img {
    width: 100%; max-width: 4.4rem; aspect-ratio: 1; object-fit: cover;
    border: 1px solid rgb(237 241 245 / 0.22);
    background: rgb(237 241 245 / 0.06);
  }
  .face[data-lead='1'] .face__img { border: 2px solid var(--sq); }
  .face__img--blank {
    display: grid; place-items: center;
    font-family: var(--display); font-weight: 900; font-size: 1.75rem;
  }
  .face__name {
    font-family: var(--display); font-weight: 700;
    font-size: 0.7rem; letter-spacing: 0.02em; line-height: 1.2;
    overflow-wrap: anywhere;
  }
</style>

<script>
  const box = document.querySelector<HTMLElement>('[data-legions]');
  if (box) {
    const boards = [...box.querySelectorAll<HTMLElement>('[data-legion]')];
    const picks = [...box.querySelectorAll<HTMLButtonElement>('[data-pick]')];

    const show = (n: string) => {
      for (const b of boards) b.hidden = b.dataset.legion !== n;
      for (const p of picks) p.setAttribute('aria-pressed', String(p.dataset.pick === n));
    };

    box.classList.add('is-live');
    for (const p of picks) p.addEventListener('click', () => show(p.dataset.pick!));
    show(picks[0]?.dataset.pick ?? '1');
  }
</script>
