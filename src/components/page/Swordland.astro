---
/**
 * Swordland Showdown.
 *
 * Ordered the way a player needs it, not the way a guide would explain it:
 * their zone and their job first, the standing orders next, and the game's
 * own rules last as reference they can come back to. Someone who opens this
 * ten minutes before the whistle should find their name without scrolling
 * past a payout table.
 *
 * Two halves, and the page keeps them apart on purpose. The zones and the
 * orders are UNITY's plan, and change when leadership changes it. The
 * phases, the payouts and the first-capture rule are how the game works,
 * and are just as true for whoever we are drawn against.
 */
import { EVENT, isTodo } from '../../content/event';
import { LEGIONS, ROSTER_FETCHED_AT, starters } from '../../content/legions';
import { useTranslations, type Lang } from '../../i18n/ui';
import Todo from '../Todo.astro';
import Countdown from '../Countdown.astro';
import BuildingTable from '../BuildingTable.astro';
import Zones from '../Zones.astro';
import Reserve from '../Reserve.astro';
import Heading from '../Heading.astro';
import { Image } from 'astro:assets';
import battlefield from '../../shots/battlefield.png';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useTranslations(lang);

const num = new Intl.NumberFormat(lang);
const SL = EVENT.swordland;

// Counted from the team sheet rather than written down, so the headline
// numbers can never disagree with the names underneath them. Both Legions
// field the same shape; if that ever stops being true the hero says so
// because it reads the larger of the two rather than assuming.
const onField = num.format(Math.max(...LEGIONS.map(starters)));
const reserve = num.format(Math.max(...LEGIONS.map((l) => l.subs.length)));
const legionCount = num.format(LEGIONS.length);
const zoneCount = num.format(SL.plan.zones.length);
const syncedOn = new Intl.DateTimeFormat(lang, { dateStyle: 'long' })
  .format(new Date(ROSTER_FETCHED_AT));

const mains = num.format(SL.legion.mains);
const subs = num.format(SL.legion.subs);
const top = num.format(SL.topAlliances);
const tp = num.format(SL.cooldowns.teleport);
const tpFast = num.format(SL.cooldowns.teleportWithStables);
const attackPay = num.format(SL.payout.attack);
const defendPay = num.format(SL.payout.defend);

// The 2x claim is derived from the two payouts, so it can never drift away
// from them the way a hard-coded "twice" would.
const payRatio = num.format(
  Math.round((SL.payout.attack / SL.payout.defend) * 10) / 10,
);

// The headline argument for the Sanctums is arithmetic, so it is done here
// rather than asserted in a sentence that could drift from the table.
const shrine = SL.buildings.find((b) => b.key === 'swordshrine')!;
const sanctum = SL.buildings.find((b) => b.key === 'sanctum')!;
const bothSanctums = num.format(sanctum.alliance.perMin * sanctum.count);
const shrineRate = num.format(shrine.alliance.perMin);
const shrineFirst = num.format(shrine.alliance.first);
const shrineFirstYou = num.format(shrine.personal.first);

// The zone leads, in zone order — the chain of command, read straight off
// the roster so it cannot fall out of step with the cards above it.
// The chain of command differs per Legion, so it is built per Legion and
// read straight off the zone leads rather than typed a second time.
const chains = LEGIONS.map((l) => ({
  n: l.n,
  rows: SL.plan.zones.filter((z) => l.zones[z.key])
    .map((z) => ({ key: z.key, lead: l.zones[z.key].lead })),
}));

// Which zones the Undercellars actually spawn in. Read off the map rather
// than assumed even, because they are not: two zones have two each and two
// have none, and a flex player told to "gather" needs to know which he is.
const cellarZones = new Intl.ListFormat(lang, { type: 'conjunction' })
  .format(SL.plan.zones.filter((z) => z.undercellars > 0)
    .map((z) => t(`zone.${z.key}.name`)));
const cellarTotal = num.format(
  SL.plan.zones.reduce((n, z) => n + z.undercellars, 0),
);

const sharedNames = new Intl.ListFormat(lang, { type: 'conjunction' })
  .format(SL.plan.sharedObjectives.map((b) => t(`bld.${b}`)));
---
<section class="band hero">
  <div class="wrap">
    <p class="eyebrow">{t('sl.eyebrow')}</p>
    <h1 class="hero__title">{t('sl.title')}</h1>
    <p class="hero__thesis">{t('sl.thesis', {
      n: onField, subs: reserve, zones: zoneCount, legions: legionCount,
    })}</p>
    <p class="hero__act"><a class="btn" href="#zones">{t('sl.cta')}</a></p>
    <Countdown lang={lang} />
  </div>
</section>

<section class="band band--iron">
  <div class="wrap">
    <Heading id="zones" class="h-section">{t('sl.zones.title')}</Heading>
    <p class="lede">{t('sl.zones.lede', { n: onField, zones: zoneCount })}</p>
    <p class="lede">{t('sl.zones.shared', { shrine: sharedNames })}</p>

    <div class="legionpick" role="group" aria-label={t('legion.choose')} data-legionpick>
      {LEGIONS.map((l, i) => (
        <button type="button" data-pick={l.n} aria-pressed={i === 0 ? 'true' : 'false'}>
          {t('legion.pick', { n: num.format(l.n) })}
        </button>
      ))}
    </div>

    {LEGIONS.map((l) => (
      <div data-legion={l.n}>
        <h3 class="legionhd">{t('legion.pick', { n: num.format(l.n) })}</h3>
        <Zones lang={lang} legion={l} />
      </div>
    ))}
    <p class="picks__note">{t('sl.zones.synced', { date: syncedOn })}</p>
  </div>
</section>

<section class="band band--drift">
  <div class="wrap">
    <Heading id="map" class="h-section">{t('sl.map.title')}</Heading>
    <p class="lede">{t('sl.map.lede', { shrine: sharedNames })}</p>
    <figure class="map">
      <div class="map__scroll">
        <Image src={battlefield} alt={t('sl.map.alt')} widths={[658, 1316]}
               sizes="(min-width: 46rem) 42rem, 34rem" loading="lazy" />
      </div>
      <figcaption class="map__cap">{t('sl.map.cap')}</figcaption>
    </figure>
    <p class="waves__warn">{t('sl.map.cellars', { n: cellarTotal, zones: cellarZones })}</p>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <Heading id="flex" class="h-section">{t('sl.flex.title')}</Heading>
    <p class="lede">{t('sl.flex.lede')}</p>
    <ol class="steps">
      {SL.plan.flexDuties.map((key, i) => (
        <li class="step">
          <p class="step__when">{num.format(i + 1)}</p>
          <div>
            <Heading id={`flex-${key}`} level={3} class="step__title">{t(`flex.${key}.title`)}</Heading>
            <p class="step__body">{t(`flex.${key}.body`)}</p>
          </div>
        </li>
      ))}
    </ol>
    <p class="waves__warn">{t('sl.flex.fallback')}</p>
  </div>
</section>

<section class="band band--drift">
  <div class="wrap">
    <Heading id="reserve" class="h-section">{t('sl.reserve.title')}</Heading>
    <p class="bignum">{reserve}</p>
    <p class="numlabel">{t('sl.reserve.numlabel')}</p>
    <p class="lede">{t('sl.reserve.lede')}</p>
    <div class="legionpick" role="group" aria-label={t('legion.choose')} data-legionpick>
      {LEGIONS.map((l, i) => (
        <button type="button" data-pick={l.n} aria-pressed={i === 0 ? 'true' : 'false'}>
          {t('legion.pick', { n: num.format(l.n) })}
        </button>
      ))}
    </div>

    {LEGIONS.map((l) => (
      <div data-legion={l.n}>
        <h3 class="legionhd">{t('legion.pick', { n: num.format(l.n) })}</h3>
        <Reserve lang={lang} legion={l} />
      </div>
    ))}

    <div class="caveat">
      <p class="caveat__head">{t('sl.reserve.head')}</p>
      <p class="caveat__body">{t('sl.reserve.body')}</p>
      <p class="caveat__do">{t('sl.reserve.do')}</p>
    </div>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <Heading id="orders" class="h-section">{t('sl.orders.title')}</Heading>
    <p class="lede">{t('sl.orders.lede')}</p>
    {SL.plan.orders.map((key, i) => (
      <div class="rule">
        <p class="rule__tag">{t('sl.orders.tag', { n: num.format(i + 1) })}</p>
        <div class="rule__body">
          <Heading id={`order-${key}`} level={3} class="rule__title">{t(`order.${key}.title`, { shrine: sharedNames })}</Heading>
          <p class="step__body">{t(`order.${key}.body`, { shrine: sharedNames })}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<section class="band band--iron">
  <div class="wrap">
    <Heading id="chain" class="h-section">{t('sl.chain.title')}</Heading>
    <p class="lede">{t('sl.chain.lede')}</p>
    <div class="legionpick" role="group" aria-label={t('legion.choose')} data-legionpick>
      {LEGIONS.map((l, i) => (
        <button type="button" data-pick={l.n} aria-pressed={i === 0 ? 'true' : 'false'}>
          {t('legion.pick', { n: num.format(l.n) })}
        </button>
      ))}
    </div>

    {chains.map(({ n, rows }) => (
      <div data-legion={n}>
        <h3 class="legionhd">{t('legion.pick', { n: num.format(n) })}</h3>
        <ul class="chain">
          {rows.map(({ key, lead }) => (
            <li class="chain__row" data-zone={key}>
              <span class="chain__zone">{t('zone.name', { zone: t(`zone.${key}.name`) })}</span>
              <span class="chain__lead">{lead.name}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
    <p class="picks__note">{t('sl.chain.note')}</p>
  </div>
</section>

{/* Everything below is how the GAME works. Same for both sides, and the
    reason the plan above is shaped the way it is. */}
<section class="band">
  <div class="wrap">
    <Heading id="roster" class="h-section">{t('sl.roster.title')}</Heading>
    <p class="bignum">{mains}</p>
    <p class="numlabel">{t('sl.roster.numlabel')}</p>
    <p class="lede">{t('sl.roster.lede', { mains, subs, top })}</p>
    <p class="lede">{t('sl.roster.subs', { subs, n: SL.legion.subsAfterMinutes })}</p>

    <div class="caveat">
      <p class="caveat__head">{t('sl.legions.head', { n: SL.legion.perAlliance })}</p>
      <p class="caveat__body">{t('sl.legions.body')}</p>
      <p class="caveat__do">{t('sl.legions.do')}</p>
    </div>
  </div>
</section>

<section class="band band--drift">
  <div class="wrap">
    <Heading id="lock" class="h-section">{t('sl.lock.title', { n: SL.opening.lockMinutes })}</Heading>
    <p class="lede">{t('sl.lock.lede', { n: SL.opening.lockMinutes })}</p>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <Heading id="phases" class="h-section">{t('sl.phases.title')}</Heading>
    <p class="lede">{t('sl.phases.lede', { minutes: SL.matchMinutes })}</p>
    <ol class="steps">
      {SL.phases.map((phase) => (
        <li class:list={['step', phase.at === 0 && 'step--launch']}>
          <p class="step__when">
            {isTodo(phase.at)
              ? <Todo value={phase.at} label={t('todo.label')} />
              : phase.at === 0
                ? t('sl.phases.start')
                : t('sl.phases.at', { n: phase.at })}
          </p>
          <div>
            <Heading id={`phase-${phase.key}`} level={3} class="step__title">{t(`phase.${phase.key}.title`)}</Heading>
            <p class="step__body">{t(`phase.${phase.key}.body`, {
              tp, tpFast, waves: SL.undercellarWaves,
            })}</p>
          </div>
        </li>
      ))}
    </ol>
    <p class="waves__warn">{t('sl.phases.warn')}</p>
  </div>
</section>

<section class="band band--iron">
  <div class="wrap">
    <Heading id="pay" class="h-section">{t('sl.pay.title')}</Heading>
    <p class="lede">{t('sl.pay.lede')}</p>
    <BuildingTable lang={lang} />
    <p class="mix__note">{t('sl.pay.note')}</p>

    <div class="caveat">
      <p class="caveat__head">{t('sl.pay.head', { bothSanctums, shrineRate })}</p>
      <p class="caveat__body">{t('sl.pay.body', { bothSanctums, shrineRate })}</p>
    </div>
  </div>
</section>

<section class="band">
  <div class="wrap">
    <Heading id="first" class="h-section">{t('sl.first.title')}</Heading>
    <p class="lede">{t('sl.first.lede')}</p>

    <div class="caveat">
      <p class="caveat__head">{t('sl.first.head')}</p>
      <p class="caveat__body">{t('sl.first.body', { pct: SL.stealPercent })}</p>
    </div>

    <div class="faq">
      <p class="faq__label">{t('sl.first.egtitle')}</p>
      <div class="faq__item">
        <p class="faq__q">{t('sl.first.egq')}</p>
        <p class="faq__a">{t('sl.first.ega', {
          shrineFirst, shrineFirstYou, shrineRate,
        })}</p>
      </div>
    </div>

    <div class="faq">
      <p class="faq__label">{t('sl.points.title')}</p>
      <div class="faq__item">
        <p class="faq__q">{t('sl.points.q')}</p>
        <p class="faq__a">{t('sl.points.a', { attackPay, defendPay, payRatio })}</p>
      </div>
    </div>
  </div>
</section>

<script>
  /* One picker, three places on the page that answer to it. With no
     JavaScript every Legion stays visible under its own heading, so the
     page is complete rather than showing two dead buttons — the same
     bargain the countdown makes. */
  const pickers = [...document.querySelectorAll<HTMLElement>('[data-legionpick]')];
  if (pickers.length) {
    const blocks = [...document.querySelectorAll<HTMLElement>('[data-legion]')];
    const buttons = pickers.flatMap((p) =>
      [...p.querySelectorAll<HTMLButtonElement>('[data-pick]')]);

    // Every picker shows the same Legion — switching at the bottom of the
    // page must not leave the top disagreeing with it.
    const show = (n: string) => {
      for (const b of blocks) b.hidden = b.dataset.legion !== n;
      for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.pick === n));
    };

    // A pasted link to #l2-purple has to bring Legion 2 with it, or it
    // scrolls to a heading this picker is currently hiding and the reader
    // lands on the wrong roster with no clue why.
    const legionForHash = () => {
      const id = decodeURIComponent(location.hash.slice(1));
      if (!id) return null;
      return document.getElementById(id)?.closest<HTMLElement>('[data-legion]')
        ?.dataset.legion ?? null;
    };

    document.documentElement.classList.add('legions-live');
    for (const b of buttons) b.addEventListener('click', () => show(b.dataset.pick!));
    show(legionForHash() ?? buttons[0]?.dataset.pick ?? '1');

    // The browser scrolls before we unhide, so once the right Legion is up
    // the target has to be brought into view again.
    const settle = () => {
      const n = legionForHash();
      if (!n) return;
      show(n);
      document.getElementById(decodeURIComponent(location.hash.slice(1)))
        ?.scrollIntoView({ block: 'start' });
    };
    addEventListener('hashchange', settle);
    if (location.hash) requestAnimationFrame(settle);
  }
</script>
